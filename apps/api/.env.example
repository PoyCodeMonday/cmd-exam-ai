# Vercel auto-provisions POSTGRES_URL and BLOB_READ_WRITE_TOKEN when you link
# a Postgres + Blob store to your Vercel project.
POSTGRES_URL=postgres://USER:PASS@HOST:PORT/DB?sslmode=require
BLOB_READ_WRITE_TOKEN=

# Admin credentials (any string)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT signing secret — set to a long random string in production
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=2h

# Branding shown on the name-tag PDF
EVENT_NAME=CMD Exam '26

# The public URL the QR code on the name tag should point at (no trailing slash).
# Set this to your Vercel deployment URL (or custom domain).
PUBLIC_URL=https://your-app.vercel.app

# Local dev only
CORS_ORIGIN=http://localhost:3000
PORT=8080
